# JARVIS settings and keys
#
# Copy this file to .env in the same folder as JARVIS.exe
# (%LOCALAPPDATA%\Programs\JARVIS), fill in what you use, and restart JARVIS.
# Never share or commit the real .env: it holds your keys.

# ---- AI provider: fill in at least one -----------------------------------
# LLM_PROVIDER is tried first; any other provider with a key is the fallback.
# One of: groq, gemini, claude (via Microsoft Foundry), anthropic
LLM_PROVIDER=groq

# Groq (has a free tier; also used for the most accurate listening, below)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude via Microsoft Foundry (LLM_PROVIDER=claude)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_MODEL=claude-opus-5

# Claude via Anthropic's own API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---- Listening --------------------------------------------------------------
# groq    - most accurate; needs GROQ_API_KEY, and falls back to local Whisper
#           on the spot if a request fails
# whisper - runs entirely on this PC
# vosk    - fastest, least accurate
STT_ENGINE=groq
WHISPER_MODEL=base.en

# ---- Phone -------------------------------------------------------------------
# Talk to JARVIS from a phone on the same wifi. Set a long random word here,
# or JARVIS picks a new one every start and the phone must be set up again.
JARVIS_PHONE_TOKEN=
# JARVIS_PHONE_PORT=8765

# Optional: a certificate the phone already trusts, e.g. from Tailscale
# (tailscale cert <name>.<tailnet>.ts.net), and the name the phone uses.
# JARVIS_CERT=C:\path\to\name.ts.net.crt
# JARVIS_KEY=C:\path\to\name.ts.net.key
# JARVIS_PHONE_HOST=name.tailnet.ts.net

# ---- Connected services (only if you set them up in mcp.json) ----------------
# mcp.json lives in your JARVIS folder (C:\Users\<you>\JARVIS) and refers to
# these by name, as ${GITHUB_TOKEN}, so the keys themselves stay here.
# GITHUB_TOKEN=
# OBS_WEBSOCKET_PASSWORD=

# ---- Optional extras -----------------------------------------------------------
# Better web research
TAVILY_API_KEY=
# 3D models from pictures
TRIPO_API_KEY=
# Pictures on request
UNSPLASH_ACCESS_KEY=

# Optional browser driver override
# JARVIS_CHROMEDRIVER=C:\path\to\chromedriver.exe

# Optional Chrome debugging endpoint
# JARVIS_CHROME_DEBUG=127.0.0.1:9222
