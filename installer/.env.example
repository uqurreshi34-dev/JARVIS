# JARVIS runtime configuration
# Copy this file to .env in the same folder as JARVIS.exe and fill in
# the providers you use. Never commit the real .env or API keys.

LLM_PROVIDER=claude

# Claude via Microsoft Foundry
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_MODEL=claude-opus-5

# Groq fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tripo 3D reconstruction
TRIPO_API_KEY=

# Speech
STT_ENGINE=vosk
WHISPER_MODEL=base.en

# Optional browser driver override
# JARVIS_CHROMEDRIVER=C:\path\to\chromedriver.exe

# Optional Chrome debugging endpoint
# JARVIS_CHROME_DEBUG=127.0.0.1:9222
