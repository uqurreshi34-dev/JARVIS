# JARVIS settings and keys
#
# Copy this file to .env in the same folder as JARVIS.exe
# (%LOCALAPPDATA%\Programs\JARVIS), fill in what you use, and restart JARVIS.
# Never share or commit the real .env: it holds your keys.

# ---- AI provider: fill in at least one -----------------------------------
# LLM_PROVIDER is tried first; any other provider with a key is the fallback.
# One of: groq, gemini, deepseek, claude (via Microsoft Foundry), anthropic
# The rest are tried in that order: Groq, Gemini, DeepSeek, Claude.
LLM_PROVIDER=groq

# Groq (has a free tier; also used for the most accurate listening, below)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek (platform.deepseek.com): paid per use but cheap; top up a balance
# first, there is no free credit. Thinking is off unless DEEPSEEK_THINKING
# says low, medium, high or max: it costs more and answers more slowly.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=off

# Claude via Microsoft Foundry (LLM_PROVIDER=claude)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_MODEL=claude-opus-5

# Claude via Anthropic's own API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---- Listening --------------------------------------------------------------
# groq    - most accurate; needs GROQ_API_KEY, and falls back to local Whisper
#           on the spot if a request fails
# whisper - runs entirely on this PC
# vosk    - fastest, least accurate
STT_ENGINE=groq
WHISPER_MODEL=base.en

# ---- Voice ------------------------------------------------------------------
# google - Google's Chirp 3 HD voices: natural and friendly. Needs a key
#          from a Google Cloud project with the Text-to-Speech API enabled
#          (billing on; 1,000,000 characters a month are free, and JARVIS
#          stops at GOOGLE_TTS_MONTHLY_CHARACTERS so none are charged).
#          Chosen by itself when GOOGLE_TTS_API_KEY is filled in.
# kokoro - a natural British voice made on this PC: no key, works offline.
#          Downloaded once (about 200 MB) the first time JARVIS starts.
# azure  - Microsoft's Ryan voice, from your own Azure Speech resource
#          (free tier: 500,000 characters a month). Chosen by itself when
#          both settings below are filled in.
# edge   - Ryan with no key, unofficial; Microsoft has refused it since
#          10 October 2026.
# Whichever is chosen, Kokoro stands in if it fails. Say "Jarvis, use the
# Google voice" or "switch to Fable" to change it at once; that choice is
# kept and wins over JARVIS_VOICE_ENGINE.
JARVIS_VOICE_ENGINE=
GOOGLE_TTS_API_KEY=
# python tools/voice_samples.py saves each British man's voice to listen
# to. Blank: en-GB-Chirp3-HD-Achird.
GOOGLE_TTS_VOICE=
# 0.25 to 2. Blank: 1.
GOOGLE_TTS_RATE=
# Blank: 950000, under the free 1,000,000.
GOOGLE_TTS_MONTHLY_CHARACTERS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# British men: bm_george, bm_fable, bm_daniel, bm_lewis. British women:
# bf_emma, bf_isabella, bf_alice, bf_lily. Blank: bm_fable.
JARVIS_KOKORO_VOICE=
# 0.5 to 2; below 1 is slower. Blank: 1.
JARVIS_KOKORO_SPEED=
# fp16 (169 MB, default) or int8 (88 MB, a little rougher).
JARVIS_KOKORO_MODEL=
# Windows' own voice, used only while Kokoro first downloads: part of an
# installed voice's name (e.g. George). Blank: a man's voice if Windows has one.
JARVIS_WINDOWS_VOICE=

# ---- Phone -------------------------------------------------------------------
# Talk to JARVIS from a phone on the same wifi. Set a long random word here,
# or JARVIS picks a new one every start and the phone must be set up again.
JARVIS_PHONE_TOKEN=
# JARVIS_PHONE_PORT=8765

# Optional: a certificate the phone already trusts, e.g. from Tailscale
# (tailscale cert <name>.<tailnet>.ts.net), and the name the phone uses.
# JARVIS_CERT=C:\path\to\name.ts.net.crt
# JARVIS_KEY=C:\path\to\name.ts.net.key
# JARVIS_PHONE_HOST=name.tailnet.ts.net

# Optional: tell your phone apart for the sensors' welcome back. With
# Tailscale on the phone, JARVIS greets you only when your phone is home.
# Its Tailscale name (only needed with more than one phone on the tailnet),
# and your home network if JARVIS guesses it wrong.
# JARVIS_PHONE_DEVICE=galaxy-a17
# JARVIS_HOME_NETWORK=192.168.1.0/24
# How long, in seconds, an alarm (movement while your phone is away) waits
# for a phone that is out of signal before it is dropped. Default 900.
# JARVIS_ALARM_PUSH_SECONDS=900

# ---- Connected services (only if you set them up in mcp.json) ----------------
# mcp.json lives in your JARVIS folder (C:\Users\<you>\JARVIS) and refers to
# these by name, as ${GITHUB_TOKEN}, so the keys themselves stay here.
# GITHUB_TOKEN=
# OBS_WEBSOCKET_PASSWORD=

# ---- Optional extras -----------------------------------------------------------
# Better web research
TAVILY_API_KEY=
# 3D models from pictures
TRIPO_API_KEY=
# Pictures on request
UNSPLASH_ACCESS_KEY=

# Optional browser driver override
# JARVIS_CHROMEDRIVER=C:\path\to\chromedriver.exe

# Optional Chrome debugging endpoint
# JARVIS_CHROME_DEBUG=127.0.0.1:9222

# His face in the reactor while he speaks; 0 turns it off
# JARVIS_HUD_FACE=1
