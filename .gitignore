.venv/
__pycache__/
*.pyc
.env
model/
*.mp3
# Local JARVIS phone HTTPS certificate
jarvis-phone-cert.pem
jarvis-phone-key.pem
jarvis-phone-ca.cer
*.ts.net.crt
*.ts.net.key
jarvis-phone-*.pem
jarvis-phone-*.cer

contacts.txt
memory.json

# Windows packaging output
build/
dist/
installer/output/

# Built Blender bridges: made from blender_extension/ by
# tools/build_blender_extension.py, never kept in git.
jarvis_bridge.zip
blender_extension/**/*.zip

# ESP32 sensor sketch: made by tools/esp32_setup.py, machine-specific or secret
arduino/*/jarvis_secrets.h
arduino/*/jarvis_config.h
arduino/jarvis_camera/toy_cloud.h
# PlatformIO's build output and the editor index it makes on each machine.
arduino/*/.pio/
arduino/*/compile_commands.json
arduino/*/*.ino.cpp
arduino/*/.cache/
# The house cam's detection sources: made by tools/femto_build.py from FEMTO-ML and the YOLO26n
# model (11 MB, and the model's licence is its own), never kept in git.
arduino/jarvis_camera/detect/
arduino/jarvis_camera/faces/
# The toy's "Jarvis" wake word model (ESP-SR), made by tools/toy_wake_model.py.
arduino/jarvis_camera/wake/
# The gold backtest's trade list (python tools/gold_backtest.py --trades).
gold-backtest-trades.csv
.venv-mev/
# The outline model (MobileSAM as ONNX, 44 MB): made by tools/sam_export.py, never kept in git.
models/mobile_sam/
# The face model (YuNet, 227 KB): fetched by tools/face_model.py, never kept in git.
models/faces/
